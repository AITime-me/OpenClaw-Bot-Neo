        },
        "network": { "enabled": false }
      }
    },
    "tools": { "web_search": null },
    "apps": {},
    "mcp_servers": {},
    "hooks": {},
    "features": {
      "auth_elicitation": false,
      "mentions_v2": true,
      "remote_plugin": false,
      "tool_suggest": false
    },
    "openai_base_url": null,
    "chatgpt_base_url": null,
    "experimental_use_unified_exec_tool": false,
    "model_context_window": 272000,
    "analytics": null,
    "desktop": null
  },
