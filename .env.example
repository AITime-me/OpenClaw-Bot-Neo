# Application draft placeholders only.
# OpenClaw environment-name compatibility is UNVERIFIED.
APP_ENV=development
APP_TIMEZONE=Etc/UTC

# Subscription authentication
OPENCLAW_AUTH_MODE=subscription-oauth
SUBSCRIPTION_AUTH_CREDENTIAL_FILE=<path-outside-repository>

# OPENAI_API_KEY is forbidden and must never be assigned here.

# Telegram adapter
TELEGRAM_ENABLED=false
TELEGRAM_CREDENTIAL_FILE=<path-outside-repository>

# External integrations
RUSSIAN_PRODUCTION_OBSERVER_ENABLED=false
EXTERNAL_SYSTEMS_ENABLED=false
EXTERNAL_MEDIA_PROVIDER_ENABLED=false
EXTERNAL_EMBEDDING_PROVIDER_ENABLED=false
PAID_FALLBACK_ENABLED=false
MULTIMEDIA_PROVIDER_ENABLED=false

# Local paths
LOCAL_STATE_PATH=<local-state-path>
LOCAL_MEMORY_PATH=<local-memory-path>
LOCAL_TASK_LEDGER_PATH=<local-task-ledger-path>
LOCAL_TEMP_MEDIA_PATH=<local-temporary-media-path>
LOCAL_QUARANTINE_PATH=<local-quarantine-path>
LOCAL_LOG_PATH=<local-log-path>

# Local application endpoint
CORE_BIND_HOST=127.0.0.1
CORE_BIND_PORT=<local-port>
